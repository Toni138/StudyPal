<!-- Floating Timer Widget -->
<div id="floatingTimer" class="floating-timer">
    <div class="floating-timer-header">
        <div style="flex: 1;">
            <div id="floatingSubject" class="floating-timer-subject"></div>
            <div id="floatingDisplay" class="floating-timer-display">00:00:00</div>
        </div>
        <button class="minimize-btn" onclick="toggleFloatingTimer()">−</button>
    </div>
    <div id="floatingControls" class="floating-controls">
        <button id="floatingPauseBtn" class="btn btn-warning btn-sm">Pause</button>
        <button id="floatingResumeBtn" class="btn btn-success btn-sm" style="display: none;">Resume</button>
        <button id="floatingStopBtn" class="btn btn-danger btn-sm">Stop</button>
        <a class="btn btn-info btn-sm" asp-controller="Study" asp-action="SessionForm">View Full</a>
        @* <button class="btn btn-info btn-sm" onclick="returnToTimer()">View Full</button> *@
    </div>
</div>

