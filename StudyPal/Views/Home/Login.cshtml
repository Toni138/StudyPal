@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg p-4 rounded-4">
                <div class="text-center mb-3">
                    <h2 class="fw-bold">Welcome Back</h2>
                    <p class="text-muted">Log in to your StudyPal account</p>
                </div>

                @if (TempData["success"] != null)
                {
                    <div class="alert alert-success">@TempData["success"]</div>
                }
                @if (TempData["error"] != null)
                {
                    <div class="alert alert-danger">@TempData["error"]</div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="UsernameorEmail" class="form-control" placeholder="example@gmail.com" aria-required="true" />
                        <label asp-for="UsernameorEmail">Username or Email</label>
                        <span asp-validation-for="UsernameorEmail" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" aria-required="true" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3">Login</button>
                    </div>
                </form>

                <div class="mt-3 text-center">
                    <small class="text-muted">Don't have an account? <a asp-action="Register">Register here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const saved = localStorage.getItem('timerState');
        const alertShownKey = 'pausedSessionSentToServer';

        if (saved && !sessionStorage.getItem(alertShownKey)) {
            const state = JSON.parse(saved);
            if (state.totalSeconds > 0 && state.isPaused) {
                // Send paused session info to the server
                fetch('/Dashboard/PausedSessionAlert', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        subject: state.currentSubject,
                        remaining: state.totalSeconds
                    })
                }).then(() => {
                    sessionStorage.setItem(alertShownKey, 'true'); // So we don’t send it again
                    location.reload(); // Reload so TempData can be used in Razor
                });
            }
        }
    });
</script>

    <script>
        @if (TempData["PausedSession"] != null)
        {
            <text>
                Swal.fire({
                    title: 'Welcome back!',
                    html: '@TempData["PausedSession"]',
                    icon: 'info',
                    confirmButtonText: 'Got it!',
                    confirmButtonColor: '#3085d6'
                });
            </text>
        }
    </script>
}
