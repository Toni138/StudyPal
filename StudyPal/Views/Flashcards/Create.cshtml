@model Flashcard
@section Styles {
	<link rel="stylesheet" href="~/css/flashcards.css" />
}
<div class="card shadow border-0 mt-4">
	<div class="card-header bg-secondary bg-gradient ml-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h2 class="text-white py-2">
					Create Flashcard
				</h2>
			</div>
		</div>
	</div>
	<div class="card-body p-4">
		<form method="post" class="row">
			<div class="border p-3">
				<div asp-validation-summary="All"></div>
				<div class="form-floating py-2 col-12">
					<input asp-for="Tag" list="tagOptions" type="text" class="form-control border-0 shadow" />
					<label asp-for="Tag" class="ms-2">Tag/Subject</label>
					<datalist id="tagOptions">
						@if (ViewBag.TagList != null)
						{
							foreach (string tag in ViewBag.TagList)
							{
								<option value="@tag" />
							}
						}
					</datalist>
					<span asp-validation-for="Tag" class="text-danger"></span>
				</div>

				<div class="form-floating py-2 col-12">
					<input asp-for="Question" type="text" class="form-control border-0 shadow" />
					<label asp-for="Question" class="ms-2"></label>

					<span asp-validation-for="Question" class="text-danger"></span>
				</div>
				<div class="form-floating py-2 col-12">
					<input asp-for="Answer" type="text" class="form-control border-0 shadow" />
					<label asp-for="Answer" class="ms-2"></label>
					<span asp-validation-for="Answer" class="text-danger"></span>
				</div>
				<div class="row pt-2">
					<div class="col-6 col-md-3">

						<button type="submit" class="btn btn-primary  form-control">Create</button>
					</div>
					<div class="col-6 col-md-3">
						<a asp-controller="Flashcards" asp-action="Index" class="btn btn-outline-primary border  form-control">
							Back
						</a>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>
