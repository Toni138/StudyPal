<div id="sessionCompleteModal" class="session-complete-modal">
    <div class="session-complete-content">
        <h2>🎉 Session Complete!</h2>
        <p>Great job studying <strong id="completedSubject"></strong>!</p>
        <p>You studied for <strong id="completedDuration"></strong></p>

        <div class="mt-4">
            <button class="extend-session-btn btn btn-success me-2" onclick="extendSession(10)">Study 10 More Minutes</button>
            <button class="extend-session-btn btn btn-primary me-2" onclick="extendSession(25)">Another 25 Minutes</button>
        </div>
        <div class="mt-3">
            <button id="finishNowBtn"  class="btn btn-secondary">Finish for Now</button>
        </div>

    </div>
</div>
