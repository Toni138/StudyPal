
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg p-4 rounded-4">
                    <div class="text-center mb-3">
                        <h2 class="fw-bold">Study Now</h2>
                        <p class="text-muted">Start a study session</p>
                    </div>

                    <!-- Study Session Form -->
                    <form id="studyForm">
                        <div class="form-floating mb-3">
                            <input type="text" id="subject" class="form-control" placeholder="Biology" required />
                            <label for="subject">Subject</label>
                        </div>

                        <!-- Duration Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">How long do you want to study?</label>

                            <!-- Quick Duration Buttons -->
                            <div class="duration-buttons">
                                <div class="duration-btn" data-minutes="25">
                                    <div class="fw-bold">25 Minutes</div>
                                    <small class="text-muted">Quick</small>
                                </div>
                                <div class="duration-btn" data-minutes="45">
                                    <div class="fw-bold">45 Minutes</div>
                                    <small class="text-muted">Standard</small>
                                </div>
                                <div class="duration-btn" data-minutes="60">
                                    <div class="fw-bold">1 Hour</div>
                                    <small class="text-muted">Deep Focus</small>
                                </div>
                                <div class="duration-btn" data-minutes="90">
                                    <div class="fw-bold">1.5 Hours</div>
                                    <small class="text-muted">Extended</small>
                                </div>
                            </div>

                            <!-- Custom Time Input -->
                            <div class="custom-time">
                                <div class="text-center mb-2">
                                    <small class="text-muted">Or set custom time:</small>
                                </div>
                                <div class="time-input-group">
                                    <div class="text-center">
                                        <input type="number" id="hours" class="time-input" min="0" max="23" value="0">
                                        <div class="time-label">Hours</div>
                                    </div>
                                    <span class="fw-bold">:</span>
                                    <div class="text-center">
                                        <input type="number" id="minutes" class="time-input" min="0" max="59" value="30">
                                        <div class="time-label">Minutes</div>
                                    </div>
                                    <span class="fw-bold">:</span>
                                    <div class="text-center">
                                        <input type="number" id="seconds" class="time-input" min="0" max="59" value="0">
                                        <div class="time-label">Seconds</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="button" id="startStudyBtn" class="btn btn-primary btn-lg rounded-3">
                                Start Study Session
                            </button>
                        </div>
                    </form>

                    <!-- Timer Section (Initially Hidden) -->
                    <div id="timerSection" class="timer-section">
                        <div class="text-center mb-3">
                            <h3 id="studySubject" class="text-primary"></h3>
                            <small class="text-muted">Study Session in Progress</small>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress mb-3" style="height: 10px;">
                            <div id="progressBar" class="progress-bar bg-success" role="progressbar" style="width: 100%"></div>
                        </div>

                        <div id="timerDisplay" class="timer-display">00:00:00</div>

                        <div class="timer-controls">
                            <button id="pauseBtn" class="btn btn-warning">Pause</button>
                            <button id="resumeBtn" class="btn btn-success" style="display: none;">Resume</button>
                            <button id="stopBtn" class="btn btn-danger">End Session</button>
					</div>

                        <div class="text-center mt-3">
                            <small class="text-muted">
                                Session Duration: <span id="sessionDuration"></span>
                            </small>
                        </div>
                </div>
            </div>
        </div>
    </div>
