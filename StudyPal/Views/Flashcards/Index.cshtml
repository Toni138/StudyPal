@using System.Globalization
@model List<Flashcard>
@{
    ViewData["Title"] = "My Flashcards";
}
@{
                       var tagCount = Model
                    .Where(f => !string.IsNullOrWhiteSpace(f.Tag))
                    .Select(f => f.Tag.ToLower())
                    .Distinct()
                    .Count();
                    }
<div class="container-fluid px-4 py-3">
    <!-- Success Message -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-1">
                <i class="bi bi-card-text text-primary me-2"></i>My Flashcards
            </h2>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body py-3">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <form method="post" asp-action="StartReview" class="d-flex gap-2">
                                <input type="number" name="count" class="form-control form-control-sm"
                                       min="1" max="@Model.Count()" value="1" placeholder="Cards to review" required style="max-width: 130px;" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-play-circle me-1"></i>Start Review
                                </button>
                            </form>
                        </div>
                        <div class="col-md-5">
                            <form method="post" asp-action="Search" class="d-flex gap-2">
                                <input type="text" name="searchTerm" class="form-control form-control-sm"
                                placeholder="Search flashcards..." value="@ViewData["SearchTerm"]" />
                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-search"></i>
                                </button>
                            </form>
                        </div>
                        <div class="col-md-3 text-end">
                            <a asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle me-1"></i>Create Flashcard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (ViewData["SearchTerm"] != null || (ViewData["TagName"] != null))
    {
        <div class="row mb-5">
            <div class="col">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Back to All Flashcards
                </a>
                @if (ViewData["TagName"] != null)
                {
                    <span class="ms-2 text-muted">Showing flashcards tagged: <strong>"@ViewData["TagName"]"</strong></span>
                }
                else
                {

                    <span class="ms-2 text-muted">Showing results for: <strong>"@ViewData["SearchTerm"]"</strong></span>
                }
            </div>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-card-text display-1 text-muted"></i>
                        </div>
                        <h4 class="text-muted mb-2">No Flashcards Found</h4>
                        <p class="text-muted mb-4">
                            @if (ViewData["SearchTerm"] != null)
                            {
                                <span>No flashcards match your search criteria.</span>
                            }
                            else
                            {
                                <span>Get started by creating your first flashcard!</span>
                            }
                        </p>
                        @if (ViewData["SearchTerm"] == null)
                        {
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>Create Your First Flashcard
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
         
        <div class="col">
            <div class="dropdown">
               <button class="btn btn-link p-0 text-muted small text-decoration-none d-flex align-items-center mb-3"
        type="button"
        id="tagDropdown"
        data-bs-toggle="dropdown"
        aria-expanded="false">
    <i class="bi bi-bookmark-fill me-1"></i>
    <span>@tagCount Tags</span>
    <i class="bi bi-chevron-down ms-1"></i>
</button>


                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="tagDropdown" style="min-width: 200px;">
                    <li>
                        <h6 class="dropdown-header">
                            <i class="bi bi-funnel me-1"></i>
                            Filter by Tag
                        </h6>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item @(string.IsNullOrEmpty(ViewBag.SelectedTag) ? "active" : "")"
                           href="@Url.Action("Index", new { tag = "" })">
                            <i class="bi bi-list-ul me-2"></i>
                            All Flashcards
                            <span class="badge bg-secondary ms-auto">@Model.Count()</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>

                    @foreach (var tag in Model
    .Where(f => !string.IsNullOrWhiteSpace(f.Tag)) // prevent null and empty
    .Select(f => f.Tag.ToLower())
    .Distinct()
    .OrderBy(t => t))
{
    var count = Model.Count(f => !string.IsNullOrWhiteSpace(f.Tag) && f.Tag.Equals(tag, StringComparison.OrdinalIgnoreCase));
    <li>
        <a class="dropdown-item @(ViewBag.SelectedTag?.ToLower() == tag ? "active" : "")"
           asp-action="FlashcardsByTag"
           asp-route-tagName="@tag">
            <i class="bi bi-bookmark-fill me-2 text-primary"></i>
            @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(tag)
            <span class="badge bg-light text-dark ms-auto">@count</span>
        </a>
    </li>
}


                    @if (!Model.Select(f => f.Tag).Where(t => !string.IsNullOrEmpty(t)).Any())
                    {
                        <li>
                            <span class="dropdown-item-text text-muted">
                                <i class="bi bi-info-circle me-2"></i>
                                No tags available
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Optional: Add some custom CSS for better styling -->
        <style>
            .dropdown-item.active {
                background-color: #e7f3ff;
                color: #0d6efd;
            }

            .dropdown-item:hover {
                background-color: #f8f9fa;
            }

            .dropdown-header {
                font-weight: 600;
                color: #6c757d;
            }

            .badge {
                font-size: 0.75em;
            }
        </style>

        <div class="row mb-3">
            <div class="col">
                <div class="d-flex align-items-center text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    <span>@Model.Count flashcard@(Model.Count == 1 ? "" : "s") total</span>
                </div>
            </div>
        </div>

        <div class="row">
            @foreach (var flashcard in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm border-0 flashcard-item">
                        <div class="card-body d-flex flex-column">
                            <div class="flex-grow-1 mb-3">
                                <a asp-action="Review" asp-route-id="@flashcard.Id"
                                class="text-decoration-none text-dark">
                                    <div class="question-preview">
                                        @if (string.IsNullOrEmpty(flashcard.Tag))
                                        {

                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-end mb-2">
                                                <span class="badge bg-light text-dark  px-2 py-1 small mb-3">
                                                    <i class="bi bi-bookmark-fill me-1"></i>
                                                    @flashcard.Tag
                                                </span>
                                            </div>
                                        }
                                        <div class="d-flex align-items-start mb-2">
                                            <i class="bi bi-question-circle text-primary me-2 mt-1"></i>
                                            <strong class="text-primary small">QUESTION</strong>
                                        </div>
                                      
                                        
                                        <p class="mb-0 question-text">@flashcard.Question</p>
                                    </div>
                                </a>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    @flashcard.CreatedAt.ToString("MMM dd")
                                </small>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Review" asp-route-id="@flashcard.Id"
                                       class="btn btn-outline-success btn-sm" title="Review">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@flashcard.Id"
                                       class="btn btn-outline-primary btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="confirmDelete('@flashcard.Id')" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<form id="deleteForm" method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="flashcardIdToDelete" />
</form>


@section scripts {
    <script src="~/js/DeleteFlashcard.js"></script>
}