@{
    ViewData["Title"] = "Home Page";
}
<div class="text-center">
    <h1 class="display-4">StudyPal</h1>
    <p class="about-intro">- your study pal that guarantees success</p>
</div>   
<div class="container mt-4 mb-4">
    <div class="row g-4">
        <div class="col-md-6">
            <a asp-action="Login" class="text-decoration-none text-dark">
                <div class="p-4 border rounded shadow-sm text-center">
                    <h2 class="fs-5">
                        <i class="bi bi-table me-2"></i> Create a study time table
                    </h2>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-action="Login" class="text-decoration-none text-dark">
                <div class="p-4 border rounded shadow-sm text-center">
                    <h2 class="fs-5">
                        <i class="bi bi-stopwatch me-2"></i> Time your study sessions
                    </h2>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-action="Login" class="text-decoration-none text-dark">
                <div class="p-4 border rounded shadow-sm text-center">
                    <h2 class="fs-5">
                        <i class="bi bi-card-text me-2"></i> Study with flashcards
                    </h2>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-action="Login" class="text-decoration-none text-dark">
                <div class="p-4 border rounded shadow-sm text-center">
                    <h2 class="fs-5">
                        <i class="bi bi-fire me-2"></i> Track your study habit
                    </h2>
                </div>
            </a>
        </div>
    </div>
</div>

<div class="text-center">
    <p class="prompt">Start Studying now <i class="bi bi-rocket-takeoff-fill"></i></p>

    <a class="btn btn-warning me-2" asp-action="Login">Login</a>

    <a class="btn btn-outline-warning" asp-action="Register"><i class="bi bi-person-plus-fill"></i> Create Account</a>
</div>
<script>
    // On landing page or login page
    localStorage.removeItem('pausedSessionAlertShown');
</script>