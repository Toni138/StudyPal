@model MyModels.TimetableInputModel
@{
    ViewData["Title"] = "Study Timetable Creator";
}

<div class="container">
    <h2>📅 Create Your Study Timetable</h2>
    <form id="timetableForm" asp-action="Create" method="post">

        <!-- Subjects Section -->
        <div class="form-section">
            <h3>📖 Subjects</h3>
            <div id="subjects-container">
                @for (int i = 0; i < Model.Subjects.Count; i++)
                {
                    <div class="subject-group">
                        <input asp-for="Subjects[i].Name" placeholder="Subject name" required />
                        <select asp-for="Subjects[i].Difficulty" required>
                            <option value="Easy">Easy</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="Hard">Hard</option>
                        </select>
                        @if (i > 0)
                        {
                            <button type="button" class="remove-btn" onclick="removeSubject(this)">×</button>
                        }
                    </div>
                }
            </div>
            <button type="button" id="addSubjectBtn" class="btn btn-secondary">➕ Add Subject</button>
        </div>

        <!-- Free Time Slots Section -->
        <div class="form-section">
            <h3>⏰ Free Time Slots</h3>
            <p class="help-text">Add the time periods when you are free to study each day. (Use 12-hour format with AM/PM)</p>

            @for (int dayIndex = 0; dayIndex < Model.DailyFreeSlots.Count; dayIndex++)
            {
                var day = Model.DailyFreeSlots[dayIndex];
                <div class="day-section">
                    <h4>@day.Day</h4>
                    <div id="slots-container-@dayIndex" class="slots-container">
                        @for (int slotIndex = 0; slotIndex < day.FreeSlots.Count; slotIndex++)
                        {
                            <div class="time-slot-group">
                                <div class="time-pair">
                                    <!-- Start Time - 12 Hour -->
                                    <div class="custom-time-input">
                                        <select class="time-input hour-select" onchange="convertTo24Hour(this)">
                                            <option value="">HH</option>
                                        </select>
                                        <span class="colon">:</span>
                                        <select class="time-input minute-select" onchange="convertTo24Hour(this)">
                                            <option value="00">00</option>
                                            <option value="15">15</option>
                                            <option value="30">30</option>
                                            <option value="45">45</option>
                                        </select>
                                        <select class="time-input ampm-select" onchange="convertTo24Hour(this)">
                                            <option value="AM">AM</option>
                                            <option value="PM">PM</option>
                                        </select>
                                    </div>

                                    <span class="to">to</span>

                                    <!-- End Time - 12 Hour -->
                                    <div class="custom-time-input">
                                        <select class="time-input hour-select" onchange="convertTo24Hour(this)">
                                            <option value="">HH</option>
                                        </select>
                                        <span class="colon">:</span>
                                        <select class="time-input minute-select" onchange="convertTo24Hour(this)">
                                            <option value="00">00</option>
                                            <option value="15">15</option>
                                            <option value="30">30</option>
                                            <option value="45">45</option>
                                        </select>
                                        <select class="time-input ampm-select" onchange="convertTo24Hour(this)">
                                            <option value="AM">AM</option>
                                            <option value="PM" selected>PM</option>
                                        </select>
                                    </div>
                                </div>

                                @if (slotIndex > 0 || day.FreeSlots.Count > 1)
                                {
                                    <button type="button" class="remove-slot-btn"
                                            onclick="removeTimeSlot(this, @dayIndex)">
                                        ×
                                    </button>
                                }
                                <span class="time-error-msg"></span>

                                <!-- Hidden real fields for model binding -->
                                <input type="hidden" name="DailyFreeSlots[@dayIndex].Day" value="@day.Day" />
                                <input type="hidden" name="DailyFreeSlots[@dayIndex].FreeSlots[@slotIndex].StartTime"
                                       class="real-start-time" value="00:00" />
                                <input type="hidden" name="DailyFreeSlots[@dayIndex].FreeSlots[@slotIndex].EndTime"
                                       class="real-end-time" value="00:00" />

                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-secondary add-slot-btn"
                            onclick="addTimeSlot(@dayIndex)">
                        ➕ Add Time Slot for @day.Day
                    </button>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary btn-submit">
            🚀 Generate My Timetable
        </button>
    </form>
</div>

<style>
    .container {
        max-width: 900px;
        margin: 40px auto;
        padding: 20px;
    }

    .form-section {
        background: #f8f9ff;
        padding: 25px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .day-section {
        margin-bottom: 35px;
        padding: 20px;
        background: rgba(255,255,255,0.7);
        border-radius: 12px;
        border: 1px solid rgba(102,126,234,0.15);
    }

    .subject-group {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

        .subject-group input,
        .subject-group select {
            padding: 12px 14px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 16px;
        }

    .time-slot-group {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        background: white;
        padding: 16px;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.06);
    }

    .time-pair {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .custom-time-input {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .time-input {
        padding: 10px 10px;
        border: 2px solid #e1e8ed;
        border-radius: 8px;
        font-size: 16px;
        background: #fff;
    }

    .colon {
        font-weight: 600;
        color: #777;
    }

    .to {
        font-weight: 600;
        color: #555;
        min-width: 25px;
        text-align: center;
    }

    .remove-slot-btn, .remove-btn {
        background: #ff4757;
        color: white;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .remove-btn {
        margin-left: 12px;
    }

    .time-error-msg {
        color: #ff4757;
        font-size: 0.9rem;
        margin-left: 12px;
        font-weight: 500;
    }

    .help-text {
        color: #666;
        font-size: 0.95rem;
        margin-bottom: 20px;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }

    .time-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
    }
</style>
<script>
    // === Add Subject Functionality ===
    document.getElementById('addSubjectBtn').addEventListener('click', function () {
        const container = document.getElementById('subjects-container');
        const subjectCount = container.querySelectorAll('.subject-group').length;

        const div = document.createElement('div');
        div.className = 'subject-group';
        div.innerHTML = `
            <input name="Subjects[${subjectCount}].Name" placeholder="Subject name" required />
            <select name="Subjects[${subjectCount}].Difficulty" required>
                <option value="Easy">Easy</option>
                <option value="Medium" selected>Medium</option>
                <option value="Hard">Hard</option>
            </select>
            <button type="button" class="remove-btn" onclick="removeSubject(this)">×</button>
        `;
        container.appendChild(div);
    });

    function removeSubject(button) {
        const container = document.getElementById('subjects-container');
        if (container.querySelectorAll('.subject-group').length > 1) {
            button.parentElement.remove();
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'Cannot Remove',
                text: 'You must have at least one subject!',
                confirmButtonColor: '#667eea'
            });
        }
    }

    // === Add Time Slot with 12-Hour Format ===
    function addTimeSlot(dayIndex) {
        const container = document.getElementById(`slots-container-${dayIndex}`);
        const slotCount = container.querySelectorAll('.time-slot-group').length;

        const div = document.createElement('div');
        div.className = 'time-slot-group';
        div.innerHTML = `
            <div class="time-pair">
                <!-- Start Time - 12 Hour -->
                <div class="custom-time-input">
                    <select class="time-input hour-select" onchange="convertTo24Hour(this)">
                        <option value="">HH</option>
                    </select>
                    <span class="colon">:</span>
                    <select class="time-input minute-select" onchange="convertTo24Hour(this)">
                        <option value="00">00</option>
                        <option value="15">15</option>
                        <option value="30">30</option>
                        <option value="45">45</option>
                    </select>
                    <select class="time-input ampm-select" onchange="convertTo24Hour(this)">
                        <option value="AM">AM</option>
                        <option value="PM">PM</option>
                    </select>
                </div>

                <span class="to">to</span>

                <!-- End Time - 12 Hour -->
                <div class="custom-time-input">
                    <select class="time-input hour-select" onchange="convertTo24Hour(this)">
                        <option value="">HH</option>
                    </select>
                    <span class="colon">:</span>
                    <select class="time-input minute-select" onchange="convertTo24Hour(this)">
                        <option value="00">00</option>
                        <option value="15">15</option>
                        <option value="30">30</option>
                        <option value="45">45</option>
                    </select>
                    <select class="time-input ampm-select" onchange="convertTo24Hour(this)">
                        <option value="AM">AM</option>
                        <option value="PM" selected>PM</option>
                    </select>
                </div>
            </div>

            <button type="button" class="remove-slot-btn" onclick="removeTimeSlot(this, ${dayIndex})">×</button>
            <span class="time-error-msg"></span>

            <!-- Hidden fields that submit to your model (TimeOnly) -->
            <input type="hidden" name="DailyFreeSlots[${dayIndex}].FreeSlots[${slotCount}].StartTime" class="real-start-time" value="00:00" />
            <input type="hidden" name="DailyFreeSlots[${dayIndex}].FreeSlots[${slotCount}].EndTime" class="real-end-time" value="00:00" />
        `;
        container.appendChild(div);

        populateHourSelects(div);
    }

    // Populate hours 1-12
    function populateHourSelects(group) {
        const hourSelects = group.querySelectorAll('.hour-select');
        hourSelects.forEach(select => {
            select.innerHTML = '<option value="">HH</option>';
            for (let i = 1; i <= 12; i++) {
                const val = i.toString().padStart(2, '0');
                const option = document.createElement('option');
                option.value = val;
                option.textContent = val;
                select.appendChild(option);
            }
        });
    }

    // Convert 12-hour format to 24-hour and update hidden fields
    function convertTo24Hour(element) {
        const group = element.closest('.time-slot-group');
        const customInputs = group.querySelectorAll('.custom-time-input');

        // Start Time
        const startHourSelect = customInputs[0].querySelector('.hour-select');
        const startMinSelect = customInputs[0].querySelector('.minute-select');
        const startAmPmSelect = customInputs[0].querySelector('.ampm-select');

        // End Time
        const endHourSelect = customInputs[1].querySelector('.hour-select');
        const endMinSelect = customInputs[1].querySelector('.minute-select');
        const endAmPmSelect = customInputs[1].querySelector('.ampm-select');

        // Convert Start Time
        if (startHourSelect.value && startMinSelect.value && startAmPmSelect.value) {
            let hour = parseInt(startHourSelect.value);
            if (startAmPmSelect.value === "PM" && hour !== 12) hour += 12;
            if (startAmPmSelect.value === "AM" && hour === 12) hour = 0;

            const startTime24 = `${hour.toString().padStart(2, '0')}:${startMinSelect.value}`;
            group.querySelector('.real-start-time').value = startTime24;
        }

        // Convert End Time
        if (endHourSelect.value && endMinSelect.value && endAmPmSelect.value) {
            let hour = parseInt(endHourSelect.value);
            if (endAmPmSelect.value === "PM" && hour !== 12) hour += 12;
            if (endAmPmSelect.value === "AM" && hour === 12) hour = 0;

            const endTime24 = `${hour.toString().padStart(2, '0')}:${endMinSelect.value}`;
            group.querySelector('.real-end-time').value = endTime24;
        }

        // Trigger validation
        validateTimeSlot(element);
    }

    // Remove Time Slot
    function removeTimeSlot(button, dayIndex) {
        const container = document.getElementById(`slots-container-${dayIndex}`);
        if (container.querySelectorAll('.time-slot-group').length > 1) {
            button.parentElement.remove();
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'Cannot Remove',
                text: 'You must have at least one time slot per day!',
                confirmButtonColor: '#667eea'
            });
        }
    }

    // Updated Validation - Works with hidden real time fields (00:00 allowed)
    function validateTimeSlot(input) {
        const group = input.closest('.time-slot-group');
        const startInput = group.querySelector('.real-start-time');
        const endInput = group.querySelector('.real-end-time');
        const errorSpan = group.querySelector('.time-error-msg');

        const start = startInput.value;
        const end = endInput.value;

        if (start && end) {
            if (start === "00:00" && end === "00:00") {
                errorSpan.textContent = "✓ No study time this day";
                errorSpan.style.color = "#28a745";
            }
            else if (start >= end) {
                errorSpan.textContent = "End time must be after start time";
                errorSpan.style.color = "#ff4757";
            }
            else {
                errorSpan.textContent = "";
            }
        }
    }

    // Form Submit Validation
    document.getElementById('timetableForm').addEventListener('submit', function (e) {
        let isValid = true;

        const timeGroups = document.querySelectorAll('.time-slot-group');

        for (let group of timeGroups) {
            const start = group.querySelector('.real-start-time').value;
            const end = group.querySelector('.real-end-time').value;
            const errorSpan = group.querySelector('.time-error-msg');

            if (start && end) {
                if (start !== "00:00" || end !== "00:00") {
                    if (start >= end) {
                        errorSpan.textContent = "End time must be after start time";
                        isValid = false;
                    }
                }
            }
        }

        if (!isValid) {
            e.preventDefault();
            Swal.fire({
                icon: 'error',
                title: 'Time Error',
                text: 'End time must be later than start time (except for 00:00 - 00:00 which means no free time)',
                confirmButtonColor: '#667eea'
            });
        }
    });

    // Initialize hour dropdowns for existing slots on page load
    document.addEventListener('DOMContentLoaded', function () {
        const existingGroups = document.querySelectorAll('.time-slot-group');
        existingGroups.forEach(group => {
            populateHourSelects(group);
        });
    });
</script>