@{
    ViewData["Title"] = "Study Timetable Creator";
}

    <div class="container">
        <h2>📚 Create Study Timetable</h2>

        <form id="timetableForm" method="post">
            <div class="form-section">
                <h3>📖 Subjects</h3>
                <div id="subjects-container">
                    <div class="subject-group">
                        <input name="Subjects[0].Name" placeholder="Enter subject name" required />
                        <select name="Subjects[0].Difficulty" required>
                            <option value="">Select Difficulty</option>
                            <option value="Easy">Easy</option>
                            <option value="Medium">Medium</option>
                            <option value="Hard">Hard</option>
                        </select>
                        <button type="button" class="remove-btn" onclick="removeSubject(this)" title="Remove subject">×</button>
                    </div>
                </div>
                <button type="button" id="addSubjectBtn" class="btn btn-secondary">
                    ➕ Add Another Subject
                </button>
            </div>

            <div class="form-section">
                <h3>⏰ Study Hours Per Day</h3>
                <div class="day-group">
                    <label>Sunday</label>
                    <input type="number" min="0" max="24" name="DailyStudyHours[Sunday].Hours" value="0" />
                    <input type="hidden" name="DailyStudyHours[Sunday].Day" value="Sunday" />
                </div>
                <div class="day-group">
                    <label>Monday</label>
                    <input type="number" min="0" max="24" name="DailyStudyHours[Monday].Hours" value="0" />
                    <input type="hidden" name="DailyStudyHours[Monday].Day" value="Monday" />
                </div>
                <div class="day-group">
                    <label>Tuesday</label>
                    <input type="number" min="0" max="24" name="DailyStudyHours[Tuesday].Hours" value="0" />
                    <input type="hidden" name="DailyStudyHours[Tuesday].Day" value="Tuesday" />
                </div>
                <div class="day-group">
                    <label>Wednesday</label>
                    <input type="number" min="0" max="24" name="DailyStudyHours[Wednesday].Hours" value="0" />
                    <input type="hidden" name="DailyStudyHours[Wednesday].Day" value="Wednesday" />
                </div>
                <div class="day-group">
                    <label>Thursday</label>
                    <input type="number" min="0" max="24" name="DailyStudyHours[Thursday].Hours" value="0" />
                    <input type="hidden" name="DailyStudyHours[Thursday].Day" value="Thursday" />
                </div>
                <div class="day-group">
                    <label>Friday</label>
                    <input type="number" min="0" max="24" name="DailyStudyHours[Friday].Hours" value="0" />
                    <input type="hidden" name="DailyStudyHours[Friday].Day" value="Friday" />
                </div>
                <div class="day-group">
                    <label>Saturday</label>
                    <input type="number" min="0" max="24" name="DailyStudyHours[Saturday].Hours" value="0" />
                    <input type="hidden" name="DailyStudyHours[Saturday].Day" value="Saturday" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-submit">
                🚀 Generate My Timetable
            </button>
        </form>
    </div>

