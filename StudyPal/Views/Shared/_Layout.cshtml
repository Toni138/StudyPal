@using Microsoft.AspNetCore.Http
@using Utility
@{
    var sessionToken = Context.Session.GetString("AppRestartToken");
    if (sessionToken == null || sessionToken != AppSessionValidator.AppRestartToken)
    {
        Context.Session.Clear();
    }

    var username = Context.Session.GetString("Username");
    bool isLoggedIn = !string.IsNullOrEmpty(username);
   
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();



}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyBuddy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudyPal.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <style>
        a {
            color: #000 !important;
        }
    </style>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-gradient border-bottom box-shadow">
            <div class="container-fluid">
                @if (!isLoggedIn)
                {
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">StudyPal</a>
                }
                else
                {
                    <a class="nav-link text-dark">StudyPal</a>
                }
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            @if (!isLoggedIn)
                            {
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            }
                            else
                            {
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Dashboard">Home</a>

                            }
                        </li>
                    </ul>
                    @if (isLoggedIn)
                    {
                        <a class="btn ml-3 " asp-controller="Account" asp-action="Index"><i class="bi bi-person-circle"></i> Profile</a>
                      
                        <form asp-controller="Home" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit"  id="logoutBtn" class="btn btn-outline-primary  border-0">Logout</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="d-flex" style="flex: auto;">
        @if (isLoggedIn)
        {
            <div class="border-secondary sidebar" style="width: 220px; min-height: 100vh;">
                <div class="sidebar-heading fw-bold p-3">
                    Menu
                </div>
                <div class="list-group list-group-flush sidebar-list " id="sidebar-list">
                    <a class="list-group-item list-group-item-action p-3"  asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                    <a class="list-group-item list-group-item-action p-3" asp-controller="Flashcards" asp-action="Index">Flashcards</a>
                    @* <a class="list-group-item list-group-item-action p-3" asp-controller="Timetable" asp-action="DisplayTimetable">Make a Timetable</a> *@
                    <a class="list-group-item list-group-item-action p-3" asp-controller="Study" asp-action="SessionForm">Study Now</a>
                </div>
            </div>
        }

        <div class="container" style="flex-grow: 1;">
            <main role="main" class="pb-3">
                @RenderBody()
                @if (!(controller == "Home" && (action == "Login" || action == "Register" || action=="Index")) && !(controller=="Study" && (action=="SessionForm")))
{
    @Html.Partial("_FloatingTimer")
}
     @if (!(controller == "Home" && (action == "Login" || action == "Register" || action=="Index")))
{
    @Html.Partial("_SessionComplete")
}
<script src="~/js/timer.js"></script>
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - StudyPal
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    const isUserLoggedIn = @isLoggedIn.ToString().ToLower();
</script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
